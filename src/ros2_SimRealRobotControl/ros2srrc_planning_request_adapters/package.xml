<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ros2srrc_planning_request_adapters</name>
  <version>0.0.1</version>
  <description>Planning request adapter that sets a default planner_id when the request sends an empty planner_id (e.g. from RViz Motion Planning plugin).</description>
  <maintainer email="Mikel.Bueno-Viso@cranfield.ac.uk">mikel</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>moveit_core</depend>
  <depend>moveit_ros_planning</depend>
  <depend>pluginlib</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
