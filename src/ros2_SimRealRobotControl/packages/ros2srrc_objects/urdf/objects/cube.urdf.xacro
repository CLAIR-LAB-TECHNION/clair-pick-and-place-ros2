<?xml version="1.0"?>

<!-- 
  CUBE.URDF.XACRO - Parametric cube object for Gazebo simulation
  
  Parameters:
    - name: Object name (default: "cube")
    - size: Cube side length in meters (default: 0.05 = 5cm)
    - mass: Object mass in kg (default: 0.1 = 100g)
    - color: Material color - red, green, blue, yellow, orange, purple, white, black
             (default: "red")
  
  Usage with SpawnObject.py:
    ros2 run ros2srrc_execution SpawnObject.py
      - -package ros2srrc_objects
      - -urdf cube.urdf.xacro
      - -name my_cube
      - -x 0.5 -y 0.0 -z 0.8
-->

<robot xmlns:xacro="http://ros.org/wiki/xacro" name="cube">

  <!-- ==================== PARAMETERS ==================== -->
  
  <!-- Object name - used for link names and Gazebo plugin -->
  <xacro:arg name="name" default="cube"/>
  
  <!-- Cube dimensions (meters) - side length -->
  <xacro:arg name="size" default="0.05"/>
  
  <!-- Mass (kg) -->
  <xacro:arg name="mass" default="0.1"/>
  
  <!-- Color selection -->
  <xacro:arg name="color" default="red"/>

  <!-- ==================== COMPUTED PROPERTIES ==================== -->
  
  <xacro:property name="obj_name" value="$(arg name)"/>
  <xacro:property name="obj_size" value="$(arg size)"/>
  <xacro:property name="obj_mass" value="$(arg mass)"/>
  <xacro:property name="obj_color" value="$(arg color)"/>
  
  <!-- Inertia for a solid cube: I = (1/6) * m * s^2 -->
  <!-- For a uniform cube: Ixx = Iyy = Izz = (1/6) * m * s^2 -->
  <xacro:property name="inertia_val" value="${(1.0/6.0) * obj_mass * obj_size * obj_size}"/>

  <!-- ==================== COLOR MATERIALS ==================== -->
  
  <material name="red">
    <color rgba="0.8 0.1 0.1 1.0"/>
  </material>
  
  <material name="green">
    <color rgba="0.1 0.8 0.1 1.0"/>
  </material>
  
  <material name="blue">
    <color rgba="0.1 0.1 0.8 1.0"/>
  </material>
  
  <material name="yellow">
    <color rgba="0.9 0.9 0.1 1.0"/>
  </material>
  
  <material name="orange">
    <color rgba="1.0 0.5 0.0 1.0"/>
  </material>
  
  <material name="purple">
    <color rgba="0.6 0.1 0.8 1.0"/>
  </material>
  
  <material name="white">
    <color rgba="0.95 0.95 0.95 1.0"/>
  </material>
  
  <material name="black">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>
  
  <material name="grey">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>

  <!-- ==================== LINK DEFINITION ==================== -->
  
  <link name="${obj_name}">
    
    <!-- Visual geometry -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${obj_size} ${obj_size} ${obj_size}"/>
      </geometry>
      <material name="${obj_color}"/>
    </visual>
    
    <!-- Collision geometry -->
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${obj_size} ${obj_size} ${obj_size}"/>
      </geometry>
    </collision>
    
    <!-- Inertial properties -->
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${obj_mass}"/>
      <inertia 
        ixx="${inertia_val}" ixy="0.0" ixz="0.0"
        iyy="${inertia_val}" iyz="0.0"
        izz="${inertia_val}"/>
    </inertial>
    
  </link>

  <!-- ==================== GAZEBO PROPERTIES ==================== -->
  
  <!-- Gazebo material colors (Gazebo Classic uses different color system) -->
  <xacro:if value="${obj_color == 'red'}">
    <gazebo reference="${obj_name}">
      <material>Gazebo/Red</material>
    </gazebo>
  </xacro:if>
  
  <xacro:if value="${obj_color == 'green'}">
    <gazebo reference="${obj_name}">
      <material>Gazebo/Green</material>
    </gazebo>
  </xacro:if>
  
  <xacro:if value="${obj_color == 'blue'}">
    <gazebo reference="${obj_name}">
      <material>Gazebo/Blue</material>
    </gazebo>
  </xacro:if>
  
  <xacro:if value="${obj_color == 'yellow'}">
    <gazebo reference="${obj_name}">
      <material>Gazebo/Yellow</material>
    </gazebo>
  </xacro:if>
  
  <xacro:if value="${obj_color == 'orange'}">
    <gazebo reference="${obj_name}">
      <material>Gazebo/Orange</material>
    </gazebo>
  </xacro:if>
  
  <xacro:if value="${obj_color == 'purple'}">
    <gazebo reference="${obj_name}">
      <material>Gazebo/Purple</material>
    </gazebo>
  </xacro:if>
  
  <xacro:if value="${obj_color == 'white'}">
    <gazebo reference="${obj_name}">
      <material>Gazebo/White</material>
    </gazebo>
  </xacro:if>
  
  <xacro:if value="${obj_color == 'black'}">
    <gazebo reference="${obj_name}">
      <material>Gazebo/Black</material>
    </gazebo>
  </xacro:if>
  
  <xacro:if value="${obj_color == 'grey'}">
    <gazebo reference="${obj_name}">
      <material>Gazebo/Grey</material>
    </gazebo>
  </xacro:if>

  <!-- Gazebo physics properties for rubber-like cube behavior -->
  <!-- High friction, no bounce, increased damping for stable grasping -->
  <gazebo reference="${obj_name}">
    <mu1>6.0</mu1>
    <mu2>6.0</mu2>
    <kp>1000000.0</kp>
    <kd>5000.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
    <selfCollide>false</selfCollide>
    <dampingFactor>0.3</dampingFactor>
    <restitution>0.0</restitution>
  </gazebo>

  <!-- ==================== GAZEBO PLUGINS ==================== -->
  
  <!-- Ground truth pose publisher -->
  <gazebo>
    <plugin name="p3d_${obj_name}" filename="libgazebo_ros_p3d.so">
      <ros>
        <namespace>/</namespace>
        <remapping>odom:=object_poses/${obj_name}</remapping>
      </ros>
      <body_name>${obj_name}</body_name>
      <frame_name>world</frame_name>
      <update_rate>30.0</update_rate>
      <xyz_offset>0 0 0</xyz_offset>
      <rpy_offset>0 0 0</rpy_offset>
      <gaussian_noise>0.0</gaussian_noise>
    </plugin>
  </gazebo>

</robot>
