%%{init: {
  'theme': 'base',
  'themeVariables': {
    'fontFamily': 'arial, helvetica, sans-serif',
    'fontSize': '22px',
    'lineColor': '#0071bc',
    'primaryTextColor': '#3c3c3c',
    'primaryColor': '#003e7e',
    'primaryBorderColor': '#0071bc',
    'clusterBkg': '#f8fafd',
    'clusterBorder': '#003e7e'
  },
  'flowchart': {
    'htmlLabels': false,
    'curve': 'basis',
    'padding': 24,
    'nodeSpacing': 35,
    'rankSpacing': 40
  }
}}%%
flowchart LR
    subgraph Shared["ONE TASK PROGRAM"]
        direction TB

        YAML["YAML program"]
        Hanoi["Tower of Hanoi"]

        YAML ==> EP["ExecuteProgram"]
        EP ==> Load["Load robot & gripper"]
        Load ==> Loop["For each step"]

        Hanoi ==> PP["Pick and Place"]

        Loop --> Motion["Motion"]
        Loop --> Pick["Pick"]
        Loop --> Place["Place"]
        Loop --> Grip["Gripper"]

        Pick ==> PP
        Place ==> PP

        Motion ==> Out["Execute on sim or real"]
        PP ==> Out
        Grip ==> Out
    end

    subgraph Sim["SIMULATION"]
        direction TB
        GZ["Gazebo world"] --> PlanS["Motion planning"] --> GripS["Sim gripper"]
    end

    subgraph Real["REAL UR5"]
        direction TB
        Arm["UR5 robot"] --> PlanR["Motion planning"] --> GripR["Real gripper"]
    end

    Out ==> PlanS
    Out ==> PlanR

    classDef hero fill:#003e7e,stroke:#0071bc,stroke-width:3px,color:#fff
    classDef step fill:#d4eaf7,stroke:#0071bc,stroke-width:2px,color:#003e7e
    classDef out fill:#0071bc,stroke:#003e7e,stroke-width:2px,color:#fff
    classDef simNode fill:#d4eaf7,stroke:#0071bc,stroke-width:2px,color:#003e7e
    classDef realNode fill:#fff0d6,stroke:#003e7e,stroke-width:2px,color:#3c3c3c

    class YAML,Hanoi,EP,Load,Loop,PP hero
    class Motion,Pick,Place,Grip step
    class Out out
    class GZ,PlanS,GripS simNode
    class Arm,PlanR,GripR realNode

    style Shared fill:#e8f0f8,stroke:#003e7e,stroke-width:4px,color:#003e7e
    style Sim fill:#f0f8ff,stroke:#0071bc,stroke-width:3px,color:#003e7e
    style Real fill:#fffaf2,stroke:#003e7e,stroke-width:3px,color:#003e7e
